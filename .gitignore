# Explicit source allowlist; local data and run outputs stay excluded.
/*
!/.gitignore
!/README.md
!/README_zh-CN.md
!/agent/
/agent/*
!/agent/__init__.py
!/agent/models.py
!/agent/planning.py
!/agent/runtime.py
!/agent/tools/
/agent/tools/*
!/agent/tools/__init__.py
!/agent/tools/code_worker.py
!/agent/tools/measured_process.py
!/agent/tools/planning.py
!/agent/tools/spatial_checks.py
!/agent/tools/worker.py
!/assets/
/assets/*
!/assets/Logo.png
!/assets/Mascot.png
!/assets/Overview.png
!/benchmark/
/benchmark/*
!/benchmark/demo/
/benchmark/demo/*
!/benchmark/demo/data/
/benchmark/demo/data/*
!/benchmark/demo/data/案例说明.txt
!/benchmark/demo/data/目录.json
!/benchmark/demo/data/资料.py
!/benchmark/demo/question.txt
!/benchmark/questions/
/benchmark/questions/*
!/benchmark/questions/.gitkeep
!/benchmark/references/
/benchmark/references/*
!/benchmark/references/.gitkeep
!/evaluate/
/evaluate/*
!/evaluate/__init__.py
!/evaluate/score.py
!/requirements.txt
!/tests/
/tests/*
!/tests/test_evaluate.py
!/tests/test_planning.py
!/tests/test_spatial_checks.py
# Credentials, generated artifacts and local settings remain excluded at every depth.
.env
.env.*
*.pem
*.key
__pycache__/
*.pyc
.venv/
