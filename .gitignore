# Public candidate: explicitly include source files, not the research workspace.
/*
!/.gitignore
!/README.md
!/README_zh-CN.md
!/assets/
/assets/*
!/assets/Logo.png
!/assets/Mascot.png
!/assets/Overview.png
!/docs/
/docs/*
!/docs/Usage_zh-CN.md
!/requirements.txt
!/traffic_agent/
/traffic_agent/*
!/traffic_agent/__init__.py
!/traffic_agent/models.py
!/traffic_agent/measured_process.py
!/traffic_agent/planning.py
!/traffic_agent/planning_tools.py
!/traffic_agent/planning_worker.py
!/traffic_agent/spatial_checks.py
!/traffic_agent/examples/
/traffic_agent/examples/*
!/traffic_agent/examples/公交站点调整问题.txt
!/traffic_agent/examples/planning_demo/
/traffic_agent/examples/planning_demo/*
!/traffic_agent/examples/planning_demo/目录.json
!/traffic_agent/examples/planning_demo/资料.py
!/traffic_agent/examples/planning_demo/案例说明.txt
!/scripts/
/scripts/*
!/scripts/run_cambridge_harvard_r2.py
!/scripts/cambridge_code_worker_v3.py
!/tests/
/tests/*
!/tests/test_planning.py
!/tests/test_spatial_checks.py
# Credentials, generated artifacts and local settings remain excluded at every depth.
.env
.env.*
*.pem
*.key
__pycache__/
*.pyc
.venv/
